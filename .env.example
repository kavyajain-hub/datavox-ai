# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI API Configuration (Optional fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# LangGraph Postgres Checkpoint Database (falls back to in-memory MemorySaver if offline)
CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/datavox_checkpoints

# Target Database for SQL Execution (defaults to local SQLite sample db)
DATABASE_URL=sqlite:///./datavox_sample.db

# Redis Configuration (Optional: falls back to local schema.json & in-memory cache if offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
